/* job_detail.wxss */
page {
  background-color: #f5f5f5;
  padding-bottom: 260rpx;
}

.container {
  min-height: 100vh;
  padding-bottom: 300rpx;
  box-sizing: border-box;
  background: #f5f5f5;
}

/* 职位头部信息 */
.job-header {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.job-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.job-salary {
  font-size: 40rpx;
  color: #ff4d4f;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.job-info {
  display: flex;
  flex-wrap: wrap;
  gap: 30rpx;
  margin-bottom: 20rpx;
}

.info-item {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #666;
}

.info-item text {
  margin-left: 8rpx;
}

.job-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

/* 各部分通用样式 */
.section {
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  margin: 14rpx 24rpx 0 24rpx;
  padding: 30rpx;
}

.section-first {
  margin-top: 8rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.section-title text {
  margin-left: 12rpx;
}

.section-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

/* 内推者有话说 */
.recommender-section {
  background: #fff;
}

.recommender-text {
  white-space: pre-wrap;
  word-break: break-word;
  color: #666;
  line-height: 1.8;
}

/* 岗位描述 */
.desc-block {
  margin-bottom: 24rpx;
}

.desc-block:last-child {
  margin-bottom: 0;
}

.desc-label {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.desc-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

/* 发布人信息 */
.publisher-container {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-wrap: nowrap;
}

.publisher-info,
.reviewer-info {
  display: flex;
  align-items: center;
}

.person-separator {
  width: 2rpx;
  height: 32rpx;
  background: #e6e6e6;
}

.publisher-name,
.reviewer-name {
  font-size: 28rpx;
  color: #666;
  margin: 0 12rpx;
}

/* 内推通道区域 */
.referral-section {
  border-top: none;
}

/* 锁定状态 */
.referral-locked {
  padding: 10rpx 0;
}

.locked-card {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 30rpx;
  display: flex;
  justify-content: space-around;
}

.locked-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.locked-text {
  font-size: 26rpx;
  color: #bbb;
}

.locked-hint {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-top: 20rpx;
}

/* 状态徽章 */
.status-badge {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.pending-badge {
  background: #fff7e6;
  color: #d48806;
}

.success-badge {
  background: #f0fff4;
  color: #389e0d;
}

.reject-badge {
  background: #fff2f0;
  color: #cf1322;
}

.status-hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
}

/* 解锁卡片 */
.unlocked-card {
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-top: 20rpx;
}

.unlocked-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.unlocked-value-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.unlocked-value {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 20rpx;
}

.link-value {
  color: #0052d9;
  font-size: 26rpx;
}

.copy-btn {
  color: #0052d9;
  background: #e6f7ff;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  white-space: nowrap;
}

/* 底部操作栏 */
.footer-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 140rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 99;
}

.favor-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 30rpx;
}

.favor-btn.active {
  background: #fff0f0;
}

.apply-btn {
  flex: 1;
}

.applied-info-btn {
  color: #666;
  background: #f5f5f5;
  border-color: #e6e6e6;
}

