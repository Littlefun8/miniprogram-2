<!--job_detail.wxml-->
<view class="container">
  <!-- 职位头部 -->
  <view class="job-header">
    <view class="job-title">{{jobDetail.title}}</view>
    <view class="job-salary">{{jobDetail.salary}}</view>
    <view class="job-info">
      <view class="info-item">
        <t-icon name="location" size="32rpx" />
        <text>{{jobDetail.location}}</text>
      </view>
      <view class="info-item">
        <t-icon name="time" size="32rpx" />
        <text>发布于 {{jobDetail.date}}</text>
      </view>
    </view>
    <view class="job-tags">
      <t-tag
        wx:for="{{jobDetail.tags}}"
        wx:key="*this"
        variant="light"
        size="small"
        style="margin-right: 12rpx;"
      >{{item}}</t-tag>
    </view>
  </view>

  <!-- 内推者有话说 -->
  <view class="section recommender-section" wx:if="{{recommenderNodes}}">
    <view class="section-title">
      <t-icon name="chat" size="36rpx" color="#0052d9" />
      <text>内推者有话说</text>
    </view>
    <view class="section-content">
      <rich-text nodes="{{recommenderNodes}}"></rich-text>
    </view>
  </view>

  <!-- 岗位描述 -->
  <view class="section" wx:if="{{jobDetail.description || jobDetail.requirements}}">
    <view class="section-title">
      <t-icon name="file-icon" size="36rpx" color="#0052d9" />
      <text>岗位描述</text>
    </view>
    <view class="section-content">
      <view class="desc-block" wx:if="{{jobDetail.description}}">
        <view class="desc-label">岗位职责</view>
        <view class="desc-text">{{jobDetail.description}}</view>
      </view>
      <view class="desc-block" wx:if="{{jobDetail.requirements}}">
        <view class="desc-label">任职要求</view>
        <view class="desc-text">{{jobDetail.requirements}}</view>
      </view>
    </view>
  </view>

  <!-- 发布人/审核人 -->
  <view class="section">
    <view class="section-title">
      <t-icon name="user" size="36rpx" color="#0052d9" />
      <text>发布人信息</text>
    </view>
    <view class="publisher-container">
      <view class="publisher-info">
        <t-avatar image="{{jobDetail.publisher.avatar}}" icon="user" size="small" />
        <text class="publisher-name">{{jobDetail.publisher.name}}</text>
        <t-tag variant="light" theme="primary" size="small">{{jobDetail.publisher.tag}}</t-tag>
      </view>
      <view class="reviewer-info" wx:if="{{jobDetail.reviewer}}">
        <t-avatar image="{{jobDetail.reviewer.avatar}}" icon="user" size="small" />
        <text class="reviewer-name">{{jobDetail.reviewer.name}}</text>
        <t-tag variant="light" theme="success" size="small">{{jobDetail.reviewer.tag}}</t-tag>
      </view>
    </view>
  </view>

  <!-- 内推通道（状态驱动） -->
  <view class="section referral-section">
    <view class="section-title">
      <t-icon name="lock-on" size="36rpx" color="#0052d9" />
      <text>内推通道</text>
    </view>

    <!-- 未登录 或 未申请：锁定状态 -->
    <view class="referral-locked" wx:if="{{!userApplicationStatus}}">
      <view class="locked-card">
        <view class="locked-item">
          <t-icon name="lock-on" size="32rpx" color="#ccc" />
          <text class="locked-text">内推码</text>
        </view>
        <view class="locked-item">
          <t-icon name="link" size="32rpx" color="#ccc" />
          <text class="locked-text">内推链接</text>
        </view>
        <view class="locked-item">
          <t-icon name="chat" size="32rpx" color="#ccc" />
          <text class="locked-text">校友微信</text>
        </view>
      </view>
      <view class="locked-hint">申请内推通过后，可查看内推码及校友联系方式</view>
    </view>

    <!-- 待审核 -->
    <view class="referral-pending" wx:if="{{userApplicationStatus === 'pending'}}">
      <view class="status-badge pending-badge">
        <t-icon name="time" size="36rpx" color="#faa61a" />
        <text>您的申请正在等待校友审核</text>
      </view>
      <view class="status-hint">审核通过后将为您解锁内推码和联系方式</view>
    </view>

    <!-- 已通过：解锁 -->
    <view class="referral-unlocked" wx:if="{{userApplicationStatus === 'accepted'}}">
      <view class="status-badge success-badge">
        <t-icon name="check-circle-filled" size="36rpx" color="#07c160" />
        <text>内推已通过，以下信息请妥善保管</text>
      </view>
      <view class="unlocked-card" wx:if="{{jobDetail.referralCode}}">
        <view class="unlocked-label">内推码</view>
        <view class="unlocked-value-row">
          <text class="unlocked-value">{{jobDetail.referralCode}}</text>
          <view class="copy-btn" bindtap="copyText" data-text="{{jobDetail.referralCode}}">复制</view>
        </view>
      </view>
      <view class="unlocked-card" wx:if="{{jobDetail.jobLink}}">
        <view class="unlocked-label">内推链接</view>
        <view class="unlocked-value-row">
          <text class="unlocked-value link-value">{{jobDetail.jobLink}}</text>
          <view class="copy-btn" bindtap="copyText" data-text="{{jobDetail.jobLink}}">复制</view>
        </view>
      </view>
      <view class="unlocked-card" wx:if="{{jobDetail.contactWechat}}">
        <view class="unlocked-label">校友微信</view>
        <view class="unlocked-value-row">
          <text class="unlocked-value">{{jobDetail.contactWechat}}</text>
          <view class="copy-btn" bindtap="copyText" data-text="{{jobDetail.contactWechat}}">复制</view>
        </view>
      </view>
    </view>

    <!-- 已拒绝 -->
    <view class="referral-rejected" wx:if="{{userApplicationStatus === 'rejected'}}">
      <view class="status-badge reject-badge">
        <t-icon name="close-circle-filled" size="36rpx" color="#ff4d4f" />
        <text>申请未通过</text>
      </view>
      <view class="status-hint">您可以浏览其他职位继续申请</view>
    </view>
  </view>
</view>

<!-- 底部操作栏 -->
<view class="footer-actions">
  <view class="favor-btn {{isFavorite ? 'active' : ''}}" bindtap="toggleFavorite">
    <t-icon name="{{isFavorite ? 'heart-filled' : 'heart'}}" size="48rpx" color="{{isFavorite ? '#ff4d4f' : '#999'}}" />
  </view>

  <!-- 未申请 -->
  <t-button wx:if="{{!userApplicationStatus}}" theme="primary" block class="apply-btn" bindtap="applyJob">申请内推</t-button>

  <!-- 待审核 -->
  <t-button wx:if="{{userApplicationStatus === 'pending'}}" theme="default" block class="apply-btn" disabled>审核中...</t-button>

  <!-- 已通过：分享 -->
  <t-button wx:if="{{userApplicationStatus === 'accepted'}}" theme="primary" block class="apply-btn" bindtap="shareToFriend">
    <t-icon name="share" size="32rpx" color="#fff" style="margin-right: 8rpx;" />
    分享给同学
  </t-button>

  <!-- 已拒绝 -->
  <t-button wx:if="{{userApplicationStatus === 'rejected'}}" theme="default" block class="apply-btn" bindtap="goToJobList">查看其他职位</t-button>
</view>
