/* pages/manage_applications/manage_applications.wxss */
.container {
  padding: 24rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header { margin-bottom: 24rpx; }
.title { display: block; font-size: 40rpx; font-weight: 600; color: #333; }
.subtitle { display: block; font-size: 26rpx; color: #999; margin-top: 8rpx; }

.loading-wrap, .empty-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 400rpx;
}

.app-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.app-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.app-job-info { flex: 1; }

.app-job-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.app-job-company {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-top: 4rpx;
}

.status-pill {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  white-space: nowrap;
}

.status-pending { background: #fff3e0; color: #e67e22; }
.status-processing { background: #e3f2fd; color: #1976d2; }
.status-accepted { background: #e8f5e9; color: #2e7d32; }
.status-rejected { background: #fbe9e7; color: #c62828; }

.app-body {
  margin-bottom: 16rpx;
}

.app-time {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.app-user {
  display: block;
  font-size: 26rpx;
  color: #333;
  margin-top: 8rpx;
}

.detail-toggle {
  margin-top: 12rpx;
}

.detail-toggle-text {
  font-size: 24rpx;
  color: #0079FE;
}

.applicant-detail {
  margin-top: 12rpx;
  padding: 16rpx;
  background: #f8fbff;
  border: 1rpx solid #e6f1ff;
  border-radius: 8rpx;
}

.app-detail-item {
  display: block;
  font-size: 24rpx;
  color: #555;
  line-height: 1.7;
}

.app-remark {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-top: 8rpx;
}

.app-actions {
  display: flex;
  gap: 24rpx;
  justify-content: flex-end;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 24rpx;
}

.btn {
  font-size: 28rpx;
  padding: 12rpx 40rpx;
  border-radius: 8rpx;
  text-align: center;
}

.btn-primary { background: #0079FE; color: #fff; }
.btn-success { background: #07c160; color: #fff; }
.btn-danger { background: #e34d59; color: #fff; }
