<!--post_job.wxml-->
<view class="container" bindtap="onTap">
  <view class="form-container">
    <view class="compact-hint">说明：带 * 的字段为必填项</view>

    <t-input label="*职位名称" placeholder="例如：前端开发工程师" value="{{formData.title}}" bind:change="onTitleChange" required />
    <t-input label="*薪资范围" placeholder="例如：15k-25k" value="{{formData.salary}}" bind:change="onSalaryChange" required tips="建议按“最低-最高”格式填写" />

    <view class="form-item">
      <t-select label="*工作地点" value="{{selectedCityIndex}}" options="{{cityOptions}}" bind:change="onCitySelectChange" placeholder="请选择工作地点" required />
    </view>
    <view class="form-item" wx:if="{{useCustomLocation}}">
      <t-input label="*自定义地点" placeholder="例如：远程 / 海外 / 其他城市" value="{{customLocation}}" bind:change="onCustomLocationChange" required />
    </view>

    <t-input label="*所属公司" placeholder="默认已填，可按实际情况修改" value="{{formData.company}}" bind:change="onCompanyChange" required />

    <view class="form-block compact-block">
      <view class="form-block-title">*职位标签</view>
      <view class="tag-selector">
        <view class="tag {{item.selected ? 'selected' : ''}}" wx:for="{{tagOptions}}" wx:key="value" bindtap="onTagSelect" data-tag="{{item.value}}">{{item.label}}</view>
      </view>
      <view class="tag-counter">已选择 <text class="counter">{{formData.tags.length}}</text>/5 个标签</view>
    </view>

    <view class="form-block compact-block">
      <view class="form-block-title">*内推者有话说</view>
      <t-textarea class="textarea-recommender" placeholder="请写明岗位优势与注意点，建议包含：团队氛围、成长空间、工作节奏" value="{{formData.recommenderComment}}" bind:change="onRecommenderCommentChange" maxlength="500" indicator />
    </view>

    <view class="form-block compact-block">
      <view class="form-block-title">*岗位描述</view>

      <view class="sub-section">
        <view class="sub-title">岗位职责</view>
        <t-textarea class="textarea-normal" placeholder="请简要列出岗位核心职责（3-5条）" value="{{formData.description}}" bind:change="onDescriptionChange" maxlength="300" indicator />
      </view>

      <view class="sub-section">
        <view class="sub-title">任职要求</view>
        <t-textarea class="textarea-normal" placeholder="请填写任职要求，可包含学历、专业、技能、经验等" value="{{formData.requirements}}" bind:change="onRequirementsChange" maxlength="300" indicator />
      </view>

      <view class="sub-section">
        <view class="sub-title">期望条件</view>
        <t-input label="期望专业" placeholder="如：计算机、软件工程" value="{{formData.expectedMajors}}" bind:change="onExpectedMajorsChange" />
        <view class="field-gap"></view>
        <t-input label="最低年级" placeholder="如：大二、研一" value="{{formData.minGrade}}" bind:change="onMinGradeChange" />
        <view class="form-tips">设置后，不匹配的学生申请时会收到提醒（仍可申请）</view>
      </view>
    </view>

    <view class="form-block compact-block">
      <view class="form-block-title">
        内推通道信息
        <text class="status-tag">仅校友审核通过后展示</text>
      </view>
      <t-input label="*岗位链接/投递方式" placeholder="请输入岗位链接或投递说明" value="{{formData.jobLink}}" bind:change="onJobLinkChange" required />
      <view class="field-gap"></view>
      <t-input label="内推码" placeholder="如有请填写推荐码" value="{{formData.referralCode}}" bind:change="onReferralCodeChange" />
      <view class="field-gap"></view>
      <t-input label="校友微信" placeholder="用于通过后沟通，建议写常用号" value="{{formData.contactWechat}}" bind:change="onContactWechatChange" />
    </view>

    <view class="form-block compact-block">
      <view class="form-block-title">发布人信息</view>
      <view class="publisher-card" wx:if="{{userType !== 'teacher'}}">
        <view class="publisher-row">
          <t-avatar image="{{currentUserAvatar}}" icon="user" size="small" />
          <text class="publisher-name">{{formData.publisherName || '当前校友'}}</text>
          <t-tag variant="light" theme="primary" size="small">{{formData.publisherType}}</t-tag>
        </view>
      </view>
      <view wx:if="{{userType === 'teacher'}}">
        <t-input label="发布人姓名" placeholder="请输入代发布的校友姓名" value="{{formData.publisherName}}" bind:change="onPublisherNameChange" />
        <view class="form-tips">老师发布岗位时，可填写代发布的校友姓名；前端展示身份统一为校友。</view>
      </view>
    </view>

    <view class="bottom-space"></view>
  </view>

  <view class="footer-actions">
    <t-button theme="primary" block size="large" class="submit-btn-fixed" bindtap="onSubmit">发布职位</t-button>
  </view>
</view>
