page {
  background: #f5f5f5;
}

.container {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.label {
  font-size: 28rpx;
  color: #666;
}

.value {
  font-size: 28rpx;
  color: #333;
}

.value.ok {
  color: #52c41a;
}

.value.pending {
  color: #fa8c16;
}

.tips {
  margin: 18rpx 0 24rpx;
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}

